{
  "manifest_version": 3,
  "name": "ARKN",
  "short_name": "ARKN",
  "version": "0.2.0",
  "description": "Privacy-first PII protection layer for regulated professionals using AI tools.",

  "icons": {
    "16": "src/icons/icon.svg",
    "48": "src/icons/icon.svg",
    "128": "src/icons/icon.svg"
  },

  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:3000/*",
    "https://*.up.railway.app/*",
    "https://umzeixsgchlddlbxhmqi.supabase.co/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/engines/candidate.js",
        "src/engines/detectors/email.js",
        "src/engines/detectors/phone.js",
        "src/engines/detectors/postcode.js",
        "src/engines/detectors/nino.js",
        "src/engines/detectors/drivelic.js",
        "src/engines/detectors/nhs.js",
        "src/engines/detectors/bank.js",
        "src/engines/detectors/claim.js",
        "src/engines/detectors/name.js",
        "src/engines/detectors/org.js",
        "src/engines/merger.js",
        "src/engines/scorer.js",
        "src/engines/policy.js",
        "src/engines/tokenizer.js",
        "src/engines/pipeline.js",

        "src/platforms/chatgpt/config.js",
        "src/platforms/chatgpt/adapter.js",
        "src/platforms/claude/config.js",
        "src/platforms/claude/adapter.js",
        "src/platforms/gemini/config.js",
        "src/platforms/gemini/adapter.js",

        "src/platforms/platform-registry.js",

        "src/injected/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/ui/unmasker.js", "src/ui/calm-note.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*", "https://*.up.railway.app/*"],
      "js": ["src/content/sync-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost:3000/*", "https://*.up.railway.app/*"],
      "js": ["src/content/sync-bridge.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ARKN — PII Protection",
    "default_icon": {
      "16": "src/icons/icon.svg",
      "32": "src/icons/icon.svg",
      "48": "src/icons/icon.svg",
      "128": "src/icons/icon.svg"
    }
  }
}
